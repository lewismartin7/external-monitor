# Copy this file to .env. Never send the completed .env file to anyone.
TZ=America/Toronto
DASHBOARD_BIND_IP=0.0.0.0
DASHBOARD_PORT=8099

# SMTP_TLS: starttls for ports such as 587/2525, implicit for port 465.
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_TLS=starttls
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=monitor@example.com
SMTP_TO=owner@example.com

# Set true for one start to verify mail, then set it back to false.
SEND_TEST_EMAIL_ON_START=false
